#!/bin/bash

# omarchy:summary=Refresh every agent usage record, upstream collectors included
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omarchy:examples=omarchy-agents-refresh | omarchy-agents-refresh --force | omarchy-agents-refresh --except opencode
# omarchy:hidden=true

# The agents panel used to call omarchy-agent-usage-update directly, which runs
# one collector per agent out of $OMARCHY_PATH/bin. A cloned plugin cannot add
# files there, so this wrapper stands in its place: it runs the upstream
# collectors and then the plugin's own opencode collector, which turns every
# subscription opencode has seen into its own record. The panel keeps a single
# refresh path — open the panel, get everything fresh — and keeps passing the
# same arguments it always did.
#
# Flags are forwarded verbatim to both sides. Both ignore agents they do not
# own, so --except and an explicit agent list work for either without
# translation.
#
# The two sides run at once and write disjoint records, so they are allowed to
# race nothing: this collector owns the codex card (see below) and everything
# else is either upstream's file or ours. Running at once is what keeps the
# panel current — the upstream claude collector can take half a minute walking
# an 8.9 GB database, and the records this plugin owns should not be held
# hostage to it.

set -uo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
COLLECTOR="$PLUGIN_DIR/bin/omarchy-agent-usage-opencode"

mkdir -p "$USAGE_DIR"

collector_available=0
[[ -x $COLLECTOR ]] && command -v python3 >/dev/null 2>&1 && collector_available=1

# The upstream command is not required: without it this plugin still refreshes
# its own agents, which is the difference between a partial panel and none.
upstream_status=0
upstream_pid=""

if command -v omarchy-agent-usage-update >/dev/null 2>&1; then
  upstream_args=("$@")
  # One writer per record. This collector builds the codex card, because
  # opencode's own Codex sign-in can read the subscription's windows even when
  # the Codex CLI cannot. Standing the upstream codex collector down keeps the
  # two from blanking each other's file. When this collector is unavailable it
  # is left enabled, so the card still exists.
  (( collector_available )) && upstream_args=(--except codex "${upstream_args[@]}")
  omarchy-agent-usage-update "${upstream_args[@]}" &
  upstream_pid=$!
fi

collector_status=0
collector_out=""
if (( collector_available )); then
  collector_out=$(mktemp)
  if ! python3 "$COLLECTOR" "$@" >"$collector_out"; then
    echo "omarchy-agents-refresh: opencode collector failed" >&2
    collector_status=1
  fi
else
  echo "omarchy-agents-refresh: opencode collector missing; upstream records only" >&2
  collector_status=1
fi

# Records are one JSON object per card; each becomes <card>.json in the usage
# directory the panel watches, which is the same contract the upstream
# collectors honour with a single record each.
if [[ -n $collector_out && -s $collector_out ]] && jq -e 'type == "object"' "$collector_out" >/dev/null 2>&1; then
  while IFS= read -r card; do
    [[ -n $card ]] || continue
    # A card id becomes a file name. Reject anything that is not a plain name:
    # a stray slash or dot segment would let a record escape the directory.
    if [[ ! $card =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
      echo "omarchy-agents-refresh: ignoring unsafe agent name '$card'" >&2
      continue
    fi
    target="$USAGE_DIR/$card.json"
    payload=$(jq -c --arg card "$card" '.[$card]' "$collector_out") || continue
    [[ -n $payload ]] || continue
    # Only touch the file when the record actually changed: the panel reloads
    # every record it watches, and a rewrite of identical content would make it
    # redraw every row on every panel open for nothing.
    if [[ -f $target ]] && [[ $(cat "$target") == "$payload" ]]; then
      continue
    fi
    tmp=$(mktemp "$USAGE_DIR/.$card.XXXXXX")
    printf '%s\n' "$payload" >"$tmp"
    mv "$tmp" "$target"
  done < <(jq -r 'keys[]' "$collector_out")
elif [[ $collector_status -eq 0 ]]; then
  echo "omarchy-agents-refresh: opencode collector printed no usable records" >&2
  collector_status=1
fi

[[ -n $collector_out ]] && rm -f "$collector_out"

if [[ -n $upstream_pid ]]; then
  wait "$upstream_pid" || upstream_status=$?
fi

exit $(( collector_status | upstream_status ))
